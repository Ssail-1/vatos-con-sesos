
# Copia este archivo a .env y configura tu contraseña solo en esa copia local.
# Las variables del entorno tienen prioridad sobre .env.
DATABASE_URL=postgresql://vcs_app:YOUR_PASSWORD@localhost:5432/vcs_dev

# Orígenes exactos autorizados para leer el planner y ejecutar las mutations conectadas.
VCS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
